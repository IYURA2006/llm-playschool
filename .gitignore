# Raw clembench dump that games_study/ is built FROM (85MB, 6k files).
# The curated study set is committed; this is not. Keep the original archive
# safe — build_study_set.py needs it to regenerate or re-seed the selection.
games_final/

# The results archive cost_estimate.py reads (307MB). GitHub rejects any file
# over 100MB outright, and a commit that contains one has to be rewritten out
# of history rather than simply reverted. The script finds the zip next to
# itself on disk, so nothing needs it to be tracked.
compute_price/*.zip
