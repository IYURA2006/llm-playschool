# Copy this file to .env and fill in real values. .env is gitignored.

# PostgreSQL connection (managed instance on host breezy, db study).
# Password auth (not Kerberos) — sslmode=require, gssencmode=disable.
DB_HOST=breezy
DB_NAME=study
DB_USER=studyuser
DB_PASSWORD=
DB_SSLMODE=require
DB_GSSENCMODE=disable

# Points the test suite at a separate, disposable database instead of the
# real `study` DB (see _test_assignment.py) — must have the same schema
# and grants applied via postgres_schema.sql.
TEST_DB_NAME=

# Port the app binds. Leave unset on the VM: the default (3000) is what Apache
# on breezy reverse-proxies to from 443, and a mismatch shows up as an Apache
# 503 rather than as anything in the app's own log. Only set it to run a second
# copy alongside the first locally.
# PORT=3001

# Which transcript tree the study serves. games/ is the 234-transcript pilot
# pool and games_study/ is the curated 416 — they share ZERO slugs, so pointing
# at the wrong one silently runs the study on the wrong corpus. assignment.
# preflight() refuses to boot if this disagrees with the batch manifest.
GAMES_DIR=games_study

# Re-enables the ?annotator=&block=&game= debug link, which bypasses the
# Prolific gate and writes annotations under any id you put in the URL, with
# no batch or template attached. Leave unset on the VM for the duration of the
# study; set to 1 locally when you need to open one specific transcript.
# ALLOW_DEBUG_LINKS=1
