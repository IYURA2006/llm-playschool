# Copy this file to .env and fill in real values. .env is gitignored.
# HF write-access token: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_DATASET_REPO=your-username/playschool-annotations

# Secret salt for pseudonymizing Prolific participant IDs before storage —
# any long random string, generated once and never reused elsewhere.
PSEUDONYM_SALT=
