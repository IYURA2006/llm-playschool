# Copy this file to .env and fill in real values. .env is gitignored.

# PostgreSQL on breezy, database `study`. Password auth, not Kerberos.
DB_HOST=breezy
DB_NAME=study
DB_USER=studyuser
DB_PASSWORD=
DB_SSLMODE=require
DB_GSSENCMODE=disable

# Sends the test suite to a separate, disposable database instead of the real
# one. It needs the same schema and grants.
TEST_DB_NAME=

# Port the app binds. Leave unset on the VM: Apache proxies to 3000, and a
# mismatch shows as a 503 with nothing in the app's log. Set it only to run a
# second copy locally.
# PORT=3001

# Which transcript tree to serve. games/ is the pilot pool, games_study/ is the
# study's 416. They share no slugs, so the wrong one runs the study on the wrong
# corpus. preflight() refuses to start if it disagrees with the batch manifest.
GAMES_DIR=games_study

# Re-enables the ?annotator=&block=&game= debug link, which skips the Prolific
# gate and writes rows under any id in the URL. Leave unset on the VM during the
# study; set to 1 locally to open one specific transcript.
# ALLOW_DEBUG_LINKS=1
