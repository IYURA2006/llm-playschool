# Copy this file to .env and fill in real values. .env is gitignored.

# Secret salt for pseudonymizing Prolific participant IDs before storage —
# any long random string, generated once and never reused elsewhere.
PSEUDONYM_SALT=

# PostgreSQL connection (managed instance on host breezy, db study).
# Password auth (not Kerberos) — sslmode=require, gssencmode=disable.
DB_HOST=breezy
DB_NAME=study
DB_USER=studyuser
DB_PASSWORD=
DB_SSLMODE=require
DB_GSSENCMODE=disable

# Points the test suite at a separate, disposable database instead of the
# real `study` DB (see _test_assignment.py) — must have the same schema
# and grants applied via postgres_schema.sql.
TEST_DB_NAME=
