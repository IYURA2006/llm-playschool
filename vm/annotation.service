# systemd user unit, installed to ~/.config/systemd/user/ by vm/setup_vm.sh,
# which rewrites the paths below for wherever the repo lives.
#
# Needs `loginctl enable-linger <user>`; computing support may have to run it.
# Without linger, systemd stops the user manager when you log out and the app
# goes with it.
[Unit]
Description=LM Playschool annotation app (Gradio, 127.0.0.1:3000)
After=network.target

[Service]
WorkingDirectory=__APP_DIR__
# db.py reads .env from the working directory, so DB_* and GAMES_DIR need no
# entry here.
#
# No PORT and no GRADIO_SERVER_NAME on purpose. app.py defaults to 3000, which
# Apache proxies to, and Gradio's default 127.0.0.1 bind keeps Apache the only
# public entry point. Setting GRADIO_SERVER_NAME to 0.0.0.0 would publish the
# app directly over plain HTTP.
#
# HOME points at local disk, not $HOME: on AFS, libpq treats "permission
# denied" on $HOME/.postgresql/ as fatal, and gradio caches there too.
Environment=HOME=__SVC_HOME__
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:__LOG_FILE__
StandardError=append:__LOG_FILE__
ExecStart=__APP_DIR__/.venv/bin/python app.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
